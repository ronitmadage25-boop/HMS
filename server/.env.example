# ───────── Database ─────────
# Paste your MongoDB connection link below (MongoDB Atlas or local).
# Example: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/hostel_management
MONGODB_URI=PASTE_YOUR_MONGODB_LINK_HERE

# ───────── Server ─────────
PORT=5000
CLIENT_URL=http://localhost:3012,http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret-string

# ───────── First administrator (created automatically on first start) ─────────
ADMIN_NAME=System Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourcollege.edu
ADMIN_PASSWORD=Admin@12345

# ───────── Invite codes needed to self-register as staff roles ─────────
# Students register freely. Wardens, Hostel Staff and Admins must enter the matching code.
WARDEN_INVITE_CODE=change-warden-code
STAFF_INVITE_CODE=change-staff-code
ADMIN_INVITE_CODE=change-admin-code

# ───────── Payment gateway ─────────
# PAYMENT_MODE=razorpay  -> real Razorpay checkout (fill the two keys below)
# PAYMENT_MODE=test      -> built-in sandbox gateway (no real money; for demos and testing)
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ───────── E-mail (optional but recommended) ─────────
# Leave SMTP_HOST empty to skip e-mails (in-app notifications still work).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hostel Office <no-reply@yourcollege.edu>
